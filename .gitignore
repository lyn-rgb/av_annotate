# Environment
.venv/
__pycache__/
*.py[cod]

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build artifacts.  setup_venv.sh installs the project from this directory
# rather than from a copy of it, so pip leaves these beside the source every
# time it runs -- and it runs on every server, which would make them the first
# thing in everyone's `git status`.
build/
*.egg-info/

# Pipeline output. Stages write here; none of it is source.
/outputs/
/work/

# Media is data, not source. The corpus is listed in data/examples.txt and lives
# on the server; committing a copy would bloat the repo and go stale.
data/examples/
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.wav

# Despite the name this is a ZIP of data/examples/, byte-identical to the
# extracted files. Excluded so it is not committed twice; it is not a document.
/data/README.md

# macOS
.DS_Store

# Model weights are fetched, not committed.
/models/

# A transfer artifact, built on demand by scripts/make_offline_bundle.sh.  Not
# source: it holds copies of other people's repositories and multi-GB weights.
/offline-bundle/
*.tar

# Transfer tarballs are built, not source.  scripts/make_transfer_zip.sh
# writes one next to the checkout every time it runs.
/*.tgz
/*.zip
